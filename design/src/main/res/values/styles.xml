<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NetworkDetectionLatencyRow" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_12</item>
        <item name="android:minHeight">@dimen/minimum_touch_target</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="ThemeOverlay" />

    <style name="ThemeOverlay.Palette.Base" parent="ThemeOverlay">
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorLogo">?attr/colorPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.Palette.Blue.Light" parent="ThemeOverlay.Palette.Base">
        <item name="colorPrimary">@color/palette_blue_light</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogPaletteBlueLight</item>
        <item name="fullScreenDialogTheme">@style/AppFullScreenDialogPaletteBlueLight</item>
    </style>
    <style name="ThemeOverlay.Palette.Blue.Dark" parent="ThemeOverlay.Palette.Base">
        <item name="colorPrimary">@color/palette_blue_dark</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogPaletteBlueDark</item>
        <item name="fullScreenDialogTheme">@style/AppFullScreenDialogPaletteBlueDark</item>
    </style>
    <style name="ThemeOverlay.Palette.Indigo.Light" parent="ThemeOverlay.Palette.Base">
        <item name="colorPrimary">@color/palette_indigo_light</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogPaletteIndigoLight</item>
        <item name="fullScreenDialogTheme">@style/AppFullScreenDialogPaletteIndigoLight</item>
