    <style name="AppBottomSheetDialogPaletteBlueLight" parent="AppBottomSheetDialogLight"><item name="colorPrimary">@color/palette_blue_light</item></style>
    <style name="AppBottomSheetDialogPaletteBlueDark" parent="AppBottomSheetDialogDark"><item name="colorPrimary">@color/palette_blue_dark</item></style>
    <style name="AppBottomSheetDialogPaletteIndigoLight" parent="AppBottomSheetDialogLight"><item name="colorPrimary">@color/palette_indigo_light</item></style>
    <style name="AppBottomSheetDialogPaletteIndigoDark" parent="AppBottomSheetDialogDark"><item name="colorPrimary">@color/palette_indigo_dark</item></style>
