    </style>
    <style name="ThemeOverlay.Palette.Purple.Light" parent="ThemeOverlay.Palette.Base">
        <item name="colorPrimary">@color/palette_purple_light</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogPalettePurpleLight</item>
