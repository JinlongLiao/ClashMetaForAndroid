    <style name="AppBottomSheetDialogPalettePurpleDark" parent="AppBottomSheetDialogDark"><item name="colorPrimary">@color/palette_purple_dark</item></style>
    <style name="AppBottomSheetDialogPaletteTealLight" parent="AppBottomSheetDialogLight"><item name="colorPrimary">@color/palette_teal_light</item></style>
