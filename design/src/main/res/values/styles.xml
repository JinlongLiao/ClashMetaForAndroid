    <style name="AppFullScreenDialogPaletteBlueLight" parent="AppFullScreenDialogLight"><item name="colorPrimary">@color/palette_blue_light</item></style>
    <style name="AppFullScreenDialogPaletteBlueDark" parent="AppFullScreenDialogDark"><item name="colorPrimary">@color/palette_blue_dark</item></style>
    <style name="AppFullScreenDialogPaletteIndigoLight" parent="AppFullScreenDialogLight"><item name="colorPrimary">@color/palette_indigo_light</item></style>
    <style name="AppFullScreenDialogPaletteIndigoDark" parent="AppFullScreenDialogDark"><item name="colorPrimary">@color/palette_indigo_dark</item></style>
    <style name="AppFullScreenDialogPalettePurpleLight" parent="AppFullScreenDialogLight"><item name="colorPrimary">@color/palette_purple_light</item></style>
    <style name="AppFullScreenDialogPalettePurpleDark" parent="AppFullScreenDialogDark"><item name="colorPrimary">@color/palette_purple_dark</item></style>
    <style name="AppFullScreenDialogPaletteTealLight" parent="AppFullScreenDialogLight"><item name="colorPrimary">@color/palette_teal_light</item></style>
    <style name="AppFullScreenDialogPaletteTealDark" parent="AppFullScreenDialogDark"><item name="colorPrimary">@color/palette_teal_dark</item></style>
    <style name="AppFullScreenDialogPaletteOrangeRedLight" parent="AppFullScreenDialogLight"><item name="colorPrimary">@color/palette_orange_red_light</item></style>
    <style name="AppFullScreenDialogPaletteOrangeRedDark" parent="AppFullScreenDialogDark"><item name="colorPrimary">@color/palette_orange_red_dark</item></style>

    <style name="ThemeOverlay.ControlColorError">
        <item name="colorControlNormal">@color/color_error</item>
        <item name="android:textColor">@color/color_error</item>
    </style>
