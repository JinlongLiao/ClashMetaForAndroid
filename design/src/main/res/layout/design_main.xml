<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="self" type="com.github.kr328.clash.design.MainDesign" />
        <variable name="clashRunning" type="boolean" />
        <variable name="forwarded" type="String" />
        <variable name="trafficUpload" type="String" />
        <variable name="trafficDownload" type="String" />
        <variable name="mode" type="String" />
        <variable name="profileName" type="String" />
        <variable name="colorClashStarted" type="int" />
        <variable name="colorClashStopped" type="int" />
        <variable name="hasProviders" type="boolean" />
        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/main_padding_horizontal"
                android:paddingTop="@{self.surface.insets.top}"
                android:paddingBottom="@{self.surface.insets.bottom}">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/main_top_banner_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="@dimen/main_logo_size"
                        android:layout_height="@dimen/main_logo_size"
                        android:background="@drawable/ic_clash" />
                    <TextView
                        android:tag="theme_accent_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/application_name"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                        android:textStyle="bold" />
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/more"
                        android:onClick="@{(view) -> self.showMoreMenu(view)}"
                        android:padding="12dp"
                        android:src="@drawable/ic_baseline_more_vert"
                        app:tint="?attr/colorControlNormal" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/status_card"
                    android:tag="theme_primary_surface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/main_status_height"
                    android:layout_marginVertical="@dimen/main_card_margin_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{() -> self.request(Request.ToggleStatus)}"
                    android:theme="@style/AppThemeDark"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:rippleColor="#33FFFFFF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_status_height"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:src="@{clashRunning ? @drawable/ic_outline_check_circle : @drawable/ic_outline_not_interested}"
                                app:tint="@android:color/white" />
                            <TextView
                                android:tag="theme_accent_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@{clashRunning ? @string/running : @string/stopped}"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                            <TextView
                                android:tag="theme_accent_text"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:text="@{clashRunning ? @string/tap_to_stop : @string/tap_to_start}"
                                android:textColor="#DFFFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:tag="theme_accent_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start"
                                android:maxLines="1"
                                android:text="@{@string/format_upload_short(trafficUpload)}"
                                android:textColor="@android:color/white"
                                android:textSize="12sp" />
                            <TextView
                                android:tag="theme_accent_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@{@string/format_download_short(trafficDownload)}"
                                android:textColor="@android:color/white"
                                android:textSize="12sp" />
                            <TextView
                                android:tag="theme_accent_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:maxLines="1"
                                android:text="@{@string/format_total_short(forwarded)}"
                                android:textColor="@android:color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/main_grid_gap"
                    android:orientation="horizontal">
                    <com.github.kr328.clash.design.view.LargeActionLabel
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_core_card_height"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:enabled="@{clashRunning}"
                        android:onClick="@{() -> self.request(Request.OpenProxy)}"
                        app:icon="@drawable/ic_baseline_vpn_lock"
                        app:subtext="@{mode}"
                        app:text="@string/proxy" />
                    <com.github.kr328.clash.design.view.LargeActionLabel
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_core_card_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> self.request(Request.OpenProfiles)}"
                        app:icon="@drawable/ic_baseline_view_list"
                        app:subtext="@{profileName != null ? profileName : @string/not_selected}"
                        app:text="@string/profile" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/main_grid_gap"
                    android:orientation="horizontal">
                    <com.github.kr328.clash.design.view.LargeActionLabel
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_tool_card_height"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:enabled="@{clashRunning}"
                        android:onClick="@{() -> self.request(Request.OpenConnections)}"
                        app:icon="@drawable/ic_baseline_apps"
                        app:text="@string/connections" />
                    <com.github.kr328.clash.design.view.LargeActionLabel
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_tool_card_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:enabled="@{clashRunning}"
                        android:onClick="@{() -> self.request(Request.OpenRules)}"
                        app:icon="@drawable/ic_baseline_assignment"
                        app:text="@string/rules" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/main_grid_gap"
                    android:orientation="horizontal">
                    <com.github.kr328.clash.design.view.LargeActionLabel
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_tool_card_height"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:enabled="@{clashRunning}"
                        android:onClick="@{() -> self.request(Request.OpenTraffic)}"
                        app:icon="@drawable/ic_baseline_swap_vert"
                        app:text="@string/traffic_history" />
                    <com.github.kr328.clash.design.view.LargeActionLabel
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/main_tool_card_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> self.request(Request.OpenLogs)}"
                        app:icon="@drawable/ic_outline_article"
                        app:text="@string/logs" />
                </LinearLayout>

                <com.github.kr328.clash.design.view.LargeActionLabel
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/main_tool_card_height"
                    android:layout_marginTop="@dimen/main_grid_gap"
                    android:onClick="@{() -> self.request(Request.OpenSettings)}"
                    app:icon="@drawable/ic_baseline_settings"
                    app:text="@string/settings" />
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
